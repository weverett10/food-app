# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Single shared password per person (no usernames/accounts) — up to two people.
# Generate each with: node scripts/hash-password.js "your-password-here"
# IMPORTANT: Next.js expands $VAR / ${VAR} inside .env files, which corrupts bcrypt
# hashes (they're full of "$"). Escape every "$" as "\$" as shown below, or the
# script's printed hash will get silently mangled and login will always fail.
# (Note: this escaping is a Next.js .env quirk only — on Vercel's dashboard, paste
# the hash WITHOUT the backslashes, since Vercel doesn't do this expansion.)
APP_PASSWORD_HASH=\$2a\$10\$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional — set this to enable a second person's password. Each person's data
# (logs, favorites) is kept completely separate.
APP_PASSWORD_HASH_2=
# Random 32+ char string used to sign session JWTs
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Firebase Admin SDK (server-only, from a service account key JSON)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
